    "lint:types": "oxlint --type-aware",
    "lint:all": "biome check src/ && oxlint --type-aware"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "globals": "^17.11.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^0.24.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
